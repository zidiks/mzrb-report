<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Отчёт МЗ РБ" Width="780" Height="660" MinWidth="540" MinHeight="360"
 WindowStartupLocation="CenterScreen" Background="#F1F5F3" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#193D38"/>
  <SolidColorBrush x:Key="Muted" Color="#61766F"/>
  <SolidColorBrush x:Key="Accent" Color="#167367"/>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#193D38"/>
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFDDD6"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.86"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#193D38"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#167367"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#167367"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="20,11"/>
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#167367"/><Setter Property="Padding" Value="0,8"/>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E4DE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#193D38"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="22,18,22,16" MaxWidth="900">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18">
    <TextBlock Text="ОТЧЁТНОСТЬ ПО ЛЕКАРСТВЕННЫМ СРЕДСТВАМ" FontSize="10" FontWeight="SemiBold" Foreground="#61766F"/>
    <TextBlock Text="Отчёт МЗ РБ" FontFamily="Bahnschrift, Segoe UI" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,9"/>
    <TextBlock Text="Выберите исходный файл и вкладку за нужный месяц." TextWrapping="Wrap" Foreground="#61766F" FontSize="14"/>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" x:Name="FileCard" AllowDrop="True" Margin="0,0,0,14">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0">
      <TextBlock Text="1. Исходный файл" FontSize="13" FontWeight="SemiBold" Foreground="#61766F" Margin="0,0,0,10"/>
      <TextBlock x:Name="FileName" Text="Выберите книгу Excel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="FileLocation" Text="Файл можно перетащить в это окно" FontSize="12" Foreground="#61766F" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Button x:Name="ChooseFile" Grid.Column="1" Content="Выбрать файл" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
    <StackPanel>
     <TextBlock Text="2. Вкладка и отчётный месяц" FontSize="13" FontWeight="SemiBold" Foreground="#61766F" Margin="0,0,0,14"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Sheets" IsEnabled="False" AutomationProperties.Name="Вкладка исходного файла"/>
      <TextBlock Grid.Column="1" Text="→" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A99F"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
       <TextBlock Text="Отчёт за" FontSize="12" Foreground="#61766F"/>
       <TextBlock x:Name="ReportMonth" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,1,0,0"/>
      </StackPanel>
     </Grid>
     <StackPanel x:Name="ManualPeriodPanel" Visibility="Collapsed" Margin="0,14,0,0">
      <TextBlock Text="В названии нет даты. Месяц и год:" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBox x:Name="ManualPeriod" Width="110" Padding="8" ToolTip="Например, 10.2026"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <StackPanel Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,20">
    <TextBlock x:Name="ProgressText" Text="Читаем выбранную вкладку…" FontSize="14" Margin="0,0,0,8"/>
    <ProgressBar Height="4" IsIndeterminate="True" Foreground="#167367" Background="#DCE8E1" BorderThickness="0"/>
   </StackPanel>
   <Border Grid.Row="4" x:Name="MessagePanel" Visibility="Collapsed" Background="#FFF4DB" CornerRadius="10" Padding="18" Margin="0,0,0,20">
    <StackPanel><TextBlock x:Name="MessageTitle" FontSize="14" FontWeight="SemiBold" Foreground="#815B1D"/><TextBlock x:Name="MessageBody" TextWrapping="Wrap" Foreground="#815B1D" Margin="0,6,0,0"/></StackPanel>
   </Border>
   <Border Grid.Row="4" x:Name="ResultPanel" Visibility="Collapsed" Background="#E3F0E9" BorderBrush="#BFDBCC" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,20">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock x:Name="ResultTitle" Text="Отчёт готов" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="ResultDetails" Foreground="#46675B" Margin="0,5,0,0"/>
      <TextBlock x:Name="ResultFile" FontSize="12" Foreground="#46675B" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
      <TextBlock Text="ВСЕГО" FontSize="10" Foreground="#46675B" HorizontalAlignment="Right"/>
      <TextBlock x:Name="ResultTotal" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <StackPanel Grid.Row="5">
    <Button x:Name="Generate" Content="Сформировать отчёт" Style="{StaticResource Primary}" IsEnabled="False"/>
    <Grid Margin="0,9,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="DestinationHint" Text="Сохранится в папку «Готовые отчёты» рядом с исходным файлом." Foreground="#61766F" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
     <Button x:Name="ResetReport" Grid.Column="1" Content="Сформировать заново" Style="{StaticResource Link}" Visibility="Collapsed" Margin="12,0,0,0"/>
     <Button x:Name="OpenFolder" Grid.Column="2" Content="Показать в папке" Style="{StaticResource Link}" Visibility="Collapsed" Margin="18,0,0,0"/>
    </Grid>
   </StackPanel>
   <StackPanel Grid.Row="6" Margin="0,14,0,0">
    <TextBlock Text="Отчётный месяц определяется по дате вкладки: 01.11 → октябрь." TextWrapping="Wrap" FontSize="12" Foreground="#778B82"/>
    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
     <TextBlock x:Name="VersionLabel" Foreground="#778B82" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
     <Button x:Name="CheckUpdates" Content="Проверить обновления" Style="{StaticResource Link}" FontSize="12"/>
    </WrapPanel>
    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontSize="12" Foreground="#61766F"/>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</Window>
