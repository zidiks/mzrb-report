<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Проверка отчёта" Width="1060" Height="680" MinWidth="540" MinHeight="360" Background="#F1F5F3" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Проверьте распределение" FontSize="22" FontWeight="SemiBold" Foreground="#193D38"/><TextBlock x:Name="ReviewProgress" Foreground="#61766F" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="ContractTitle" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="#193D38"/><TextBlock x:Name="ContractHelp" TextWrapping="Wrap" Foreground="#61766F" Margin="0,7,20,0"/></StackPanel>
    <StackPanel Grid.Column="1" x:Name="ContractDatePanel"><TextBlock Text="Дата договора" FontSize="12" Foreground="#61766F" Margin="0,0,0,4"/><TextBox x:Name="ContractDate" Width="140" Padding="8" ToolTip="дд.мм.гггг"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" x:Name="TableHeading" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Препараты и суммы, руб." FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#193D38"/><Button x:Name="AddDrug" Grid.Column="1" Content="Добавить препарат" Style="{DynamicResource Link}"/></Grid>
  <Grid Grid.Row="3">
   <DataGrid x:Name="ReviewGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E9E4" Background="White" BorderBrush="#D6E2DB" RowHeaderWidth="0" MinHeight="100" MaxHeight="240" RowHeight="36" ColumnHeaderHeight="38" SelectionMode="Single"/>
   <StackPanel x:Name="WarningPage" Visibility="Collapsed">
    <TextBlock Text="Эти записи не вошли в отчёт: для них не указан месяц. Проверьте, что среди них нет нужных данных. Если они нужны, добавьте месяц в исходном файле и сформируйте отчёт заново." TextWrapping="Wrap" Foreground="#815B1D" Margin="0,0,0,14"/>
    <TextBox x:Name="UndatedRows" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="160" Background="White" Padding="12"/>
    <CheckBox x:Name="WarningsConfirmed" Content="Проверено: можно сформировать отчёт без этих записей" Margin="0,16,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,14,0,15">
   <TextBlock x:Name="Balance" FontWeight="SemiBold" Foreground="#193D38"/>
   <TextBlock x:Name="ReviewError" Foreground="#A33C2B" TextWrapping="Wrap" Margin="0,7,0,0"/>
   <Expander x:Name="SourceExpander" Header="Посмотреть исходные записи и пояснение" Foreground="#61766F" Margin="0,12,0,0">
    <StackPanel><TextBlock x:Name="Explanation" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,8"/><DataGrid x:Name="SourceRows" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" MaxHeight="125" HeadersVisibility="Column"/></StackPanel>
   </Expander>
  </StackPanel>
  <WrapPanel Grid.Row="5">
   <Button x:Name="ReviewBack" Content="Назад" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="ReviewCancel" Content="Продолжить позже" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="SaveDraft" Content="Сохранить черновик" Padding="12,8" Margin="0,0,8,8"/>
   <Button x:Name="ReviewNext" Content="Подтвердить и дальше" Style="{DynamicResource Primary}" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
 </ScrollViewer>
</Window>
